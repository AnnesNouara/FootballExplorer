
@page "/"

<PageTitle>Football Explorer</PageTitle>

<div class="dashboard">

    <header class="dashboard-header">
        <div>
            <h1>Football Explorer ⚽</h1>
            <p>Explore the world of football.</p>
        </div>
    </header>

    <section class="welcome-section">
        <h2>Welcome back!</h2>
        <p>Your home for football fixtures, results and league standings.</p>
    </section>

    <h2 class="section-title">Explore Competitions</h2>

    <div class="competition-grid">

        <div class="competition-card">
            <span>🏴</span>
            <h3>Premier League</h3>
            <p>England</p>
        </div>

        <div class="competition-card">
            <span>🇪🇸</span>
            <h3>La Liga</h3>
            <p>Spain</p>
        </div>

        <div class="competition-card">
            <span>🇩🇪</span>
            <h3>Bundesliga</h3>
            <p>Germany</p>
        </div>

        <div class="competition-card">
            <span>🇮🇹</span>
            <h3>Serie A</h3>
            <p>Italy</p>
        </div>

    </div>

    <h2 class="section-title">Application Features</h2>

    <div class="features-grid">

        <div class="feature-card">
            <h3>📊 League Standings</h3>
            <p>Explore league tables and team positions.</p>
        </div>

        <div class="feature-card">
            <h3>📅 Fixtures & Results</h3>
            <p>Check upcoming matches and previous results.</p>
        </div>

        <div class="feature-card">
            <h3>🛡️ Teams</h3>
            <p>Discover teams and their information.</p>
        </div>

        <div class="feature-card">
            <h3>⚽ Top Scorers</h3>
            <p>Explore the leading goalscorers.</p>
        </div>

    </div>

</div>
